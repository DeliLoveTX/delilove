rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPERS ============
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'fxcuyair';
    }

    // ============ USERNAMES ============
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    // ============ USERS ============
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid)
        && request.resource.data.balance == 100;
      // Admin puede modificar cualquier usuario (para dar dinero, resetear, etc.)
      // Dueño puede modificar su propio usuario solo con ciertos campos limitados
      allow update: if isAuth() && (
        isAdmin()
        ||
        (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['balance', 'lastEarn', 'earnDay', 'earned', 'lastPay'])
          && request.resource.data.balance >= 0
        )
      );
      allow delete: if isAdmin();
    }

    // ============ PROFILES ============
    match /profiles/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============ BANNERS ============
    match /banners/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============ XP ============
    match /xp/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============ FRIENDS ============
    match /friends/{friendId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth() && request.auth.uid in request.resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if isAuth() && request.auth.uid in resource.data.members;
    }

    // ============ CHATS ============
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create, update: if isAuth() && request.auth.uid in request.resource.data.members;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ============ GROUPS ============
    match /groups/{groupId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth() && request.auth.uid in request.resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ============ ORDERS ============
    match /orders/{orderId} {
      allow read: if isAuth() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // ============ GAMES ============
    match /games/{gameId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid in request.resource.data.players;
      allow update: if isAuth() && request.auth.uid in resource.data.players;
      allow delete: if isAdmin();
    }

    // ============ PREFS ============
    match /prefs/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ============ BLOCKS ============
    match /blocks/{blockId} {
      allow read: if isAuth() && resource.data.by == request.auth.uid;
      allow create: if isAuth() && request.resource.data.by == request.auth.uid;
      allow delete: if isAuth() && resource.data.by == request.auth.uid;
      allow update: if false;
    }

    // ============ CHAT BACKGROUNDS ============
    match /chatbg/{bgId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.uid == request.auth.uid;
    }

    // ============ ROOMS (CINEMA) ============
    match /rooms/{roomId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
      match /c/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
